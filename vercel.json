{
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/telegram/:path*",
      "destination": "/api/telegram?action=:path*"
    },
    {
      "source": "/api/cloudsql/:path*",
      "destination": "/api/cloudsql?action=:path*"
    }
  ]
}

